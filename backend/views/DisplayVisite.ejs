<!DOCTYPE html>
<html>
<head>
  <title>Visit Results</title>
  <link rel="stylesheet" href="/Style.css">
</head>
<body>

<header>
  <div class="nav-inner">
    <a href="index.html" class="nav-logo">
      <div class="pin"><div></div></div>
      LocLogger
    </a>
    <nav>
      <ul>
        <li><a href="/index.html"  >Home</a></li>
        <li><a href="/addvisit.html">Add Visit</a></li>
        <li><a href="/ViewVisit.html">View Visits</a></li>
        <li><a href="/UpdateVisit.html" >Update Visits</a></li>
        <li><a href="/DeleteVisit.html" >Delete Visits</a></li>
      </ul>
    </nav>
  </div>
</header>

<div class="container">
  <h2>Results for "<%= location %>"</h2>

  <div class="card">
    <% if (visits.length === 0) { %>
      <p>No visits found for "<%= location %>"</p>
    <% } else { %>
      <table border="1" cellpadding="8" cellspacing="0" width="100%">
        <thead>
          <tr>
            <th>ID</th>
            <th>Location</th>
            <th>Date</th>
            <th>Notes</th>
          </tr>
        </thead>
        <tbody>
          <% visits.forEach(v => { %>
            <tr>
              <td><%= v.id %></td>
              <td><%= v.location %></td>
              <td><%= v.date %></td>
              <td><%= v.notes || '—' %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>

    <br>
    <a href="/ViewVisit.html" class="btn-ghost">← Go Back</a>
  </div>
</div>

</body>
</html>